rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }

    // Role documents are protected separately from application data.
    // Users can read only their own role document.
    // Only an admin can create, update, or delete role documents.
    match /users/{userId} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());

      allow create, update, delete: if isAdmin();
    }

    // Application data:
    // Authenticated users have read-only access.
    // Only admins can create, update, or delete data.
    match /teams/{documentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /matches/{documentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /players/{documentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /player_teams/{documentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /player_match_performances/{documentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
